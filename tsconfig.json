{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
"paths": {
      "@/*": ["./*"],
      "@errors/*": ["./errors/*"],
      "@constants/*": ["./constants/*"],
      "@domain/*": ["./domain/*"],
      "@clients/*": ["./clients/*"],
      "@database/*": ["./database/*"],
      "@db-schemas": ["./database/schemas/index.ts"],
      "@db-schemas/*": ["./database/schemas/*"],
      "@db-relations": ["./database/relations/index.ts"],
      "@db-relations/*": ["./database/relations/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
