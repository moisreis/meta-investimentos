{
  "name": "meta-investimentos",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "structure": "tsx scripts/check-structure.ts && tsx scripts/check-presentation-structure.ts && tsx scripts/check-test-structure.ts",
    "verify": "npm run typecheck && npm run typecheck:tests && npm run structure && npm run lint && prettier --check \"**/*.{ts,tsx}\"",
    "inngest:dev": "inngest-cli dev",
    "test": "vitest run --config vitest.config.unit.ts && vitest run --config vitest.config.integration.ts",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.unit.ts && vitest run --coverage --config vitest.config.integration.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@react-pdf/tailwind": "^0.2.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "fflate": "^0.8.3",
    "inngest": "^4.20.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "inngest-cli": "^1.44.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^2.0.0"
  }
}
